{
  "name": "selfmanaged",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "build": "tsc -b && vite build && cd server && npm run build && cd ../apps/mcp && npm run build && cd ../gpt-actions && npm run build",
    "build:appwrite": "tsc -b && vite build --mode appwrite --outDir dist/appwrite",
    "appwrite:plan": "node scripts/appwrite/provision.mjs --dry-run",
    "appwrite:provision": "node scripts/appwrite/provision.mjs",
    "appwrite:provision-compute": "node scripts/appwrite/provision-compute.mjs",
    "appwrite:deploy-preview": "npm run build:appwrite && node scripts/appwrite/deploy-preview.mjs",
    "appwrite:activate": "node scripts/appwrite/activate-site.mjs",
    "appwrite:release": "npm run appwrite:deploy-preview && npm run appwrite:activate",
    "appwrite:export": "node scripts/appwrite/export-current-prod.mjs",
    "appwrite:import": "node scripts/appwrite/import-export.mjs",
    "appwrite:verify": "node scripts/appwrite/verify.mjs",
    "appwrite:status": "node scripts/appwrite/status.mjs",
    "build:electron": "cd electron && npm run build",
    "build:mcp": "cd apps/mcp && npm run build",
    "mcp:dev": "cross-env TM_API_URL=http://localhost:3002 node apps/mcp/dist/index.js",
    "build:gpt-actions": "cd apps/gpt-actions && npm run build",
    "gpt-actions:dev": "cross-env TM_API_URL=http://localhost:3002 GPT_ACTIONS_API_KEY=dev-only-placeholder-key GPT_ACTIONS_PORT=3003 node apps/gpt-actions/dist/gpt-actions/src/index.js",
    "start:prod": "npm run build && cross-env DB_FILE=data.db PORT=3001 node server/dist/index.js",
    "start:prod:run": "cross-env DB_FILE=data.db PORT=3001 node server/dist/index.js",
    "prod": "npm run start:prod",
    "prod:run": "npm run start:prod:run",
    "dev:mobile": "vite --config apps/mobile/vite.config.ts",
    "build:mobile": "vite build --config apps/mobile/vite.config.ts",
    "build:mobile:appwrite": "vite build --config apps/mobile/vite.config.ts --mode appwrite",
    "db:seed-dev": "node scripts/seed-dev-db.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "tsx scripts/recurrence.test.ts && tsx scripts/todayflag.test.ts && tsx scripts/ics.test.ts && tsx scripts/widgetmeta.test.ts && tsx scripts/sharefields.test.ts && tsx scripts/pomodoro.test.ts && tsx scripts/evernote.test.ts && tsx scripts/totals.test.ts && tsx scripts/mobileweek.test.ts && tsx scripts/todaymarker.test.ts && tsx scripts/mcp.test.ts && tsx scripts/gpt-actions.test.ts",
    "test:report": "node scripts/run-tests.mjs",
    "test:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-summary.test.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-remote.ps1",
    "release:local-legacy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-local-legacy.ps1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "appwrite": "^27.0.0",
    "date-fns": "^4.4.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "express": "^4.22.3",
    "globals": "^17.6.0",
    "node-appwrite": "^29.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
