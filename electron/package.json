{
  "name": "selfmanaged-electron",
  "version": "1.3.2",
  "private": true,
  "description": "SelfManaged — Desktop-Client",
  "author": {
    "name": "SonGoku2078",
    "email": "SonGoku2078@users.noreply.github.com"
  },
  "homepage": "https://github.com/SonGoku2078/SelfManaged",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "tsc && electron-builder --win --x64",
    "build:mac": "tsc && electron-builder --mac",
    "build:linux": "tsc && electron-builder --linux --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "at.selfmanaged.app",
    "productName": "SelfManaged",
    "directories": {
      "output": "../dist-electron"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "SonGoku2078",
        "repo": "SelfManaged"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "../public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "icon": "../public/icon-512.png",
      "category": "Office",
      "executableName": "selfmanaged",
      "synopsis": "Aufgaben- und Projektverwaltung",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../public/icon-512.png",
          "to": "icon.png"
        }
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libxss",
        "libxtst",
        "at-spi2-core",
        "libsecret",
        "xdg-utils"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
