{
  "manifest_version": 3,
  "name": "SelfManaged – Proton Mail → Aufgabe",
  "version": "2.0.0",
  "description": "Proton-Mails mit einem Klick als Aufgaben direkt an SelfManaged senden.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://mail.proton.me/*",
    "https://fra.cloud.appwrite.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "E-Mail als Aufgabe (Alt+Shift+T)",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Mail als Aufgabe übernehmen"
    },
    "add-inbox": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Offene Mail direkt in die SelfManaged-Inbox (ohne Fenster)"
    }
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "key": ""
}
