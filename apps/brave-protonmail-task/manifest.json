{
  "manifest_version": 3,
  "name": "SelfManaged – Proton Mail → Aufgabe",
  "version": "1.1.0",
  "description": "Macht aus der offenen Proton-Mail mit einem Klick eine Aufgabe in SelfManaged.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://mail.proton.me/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "E-Mail als Aufgabe (Alt+Shift+T)",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Mail als Aufgabe übernehmen"
    },
    "add-inbox": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Offene Mail direkt in die SelfManaged-Inbox (ohne Fenster)"
    }
  },
  "options_page": "options.html"
}
